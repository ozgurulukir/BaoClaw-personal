{
  "name": "baoclaw-monorepo",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "ts-ipc",
    "baoclaw-telegram",
    "baoclaw-web",
    "baoclaw-feishu",
    "baoclaw-whatsapp"
  ],
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "baoclaw-whatsapp": true
  },
  "scripts": {
    "prepare": "husky || exit 0",
    "format": "prettier --write . && cargo fmt --manifest-path baoclaw-core/Cargo.toml --all",
    "lint": "eslint . --ext .ts,.tsx && cargo clippy --manifest-path baoclaw-core/Cargo.toml --all-targets --all-features -- -D warnings",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:cli": "npm run build -w baoclaw-ipc",
    "check:web": "npm run check -w baoclaw-web",
    "check": "cargo check --manifest-path baoclaw-core/Cargo.toml --all-targets --all-features",
    "verify-all": "npm run format && npm run lint && npm run typecheck && npm run check"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.5.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0"
  }
}
